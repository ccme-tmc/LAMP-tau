# 旋轨耦合会造成自旋简并度的破缺，所以需要用SISO方法进行计算 

psh_start = time.time()
mypsh = psh.PSH(mysiso,Nstate=int(16),lmax=int(12),TFO=1,TFB=0,ROT=True)
mypsh.kernel()
psh_end = time.time()
print('PSH time', psh_end - psh_start)

